{
    "target": "esp32s3",
    "builds": [
        {
            "name": "openclaw-v2.7",
            "sdkconfig_append": [
        "CONFIG_BOARD_TYPE_OPENCLAW_V2_7=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/openclaw_v2_7_16m.csv\"",
        "CONFIG_FLASH_NONE_ASSETS=y",
        "# CONFIG_WAKE_WORD_DISABLED is not set",
        "CONFIG_USE_AFE_WAKE_WORD=y",
        "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y",
        "CONFIG_SEND_WAKE_WORD_DATA=y",
        "CONFIG_SPIRAM=y",
        "CONFIG_SPIRAM_MODE_OCT=y",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_SPIRAM_USE_MALLOC=y",
        "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384",
        "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768",
        "CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y",
        "CONFIG_MBEDTLS_DYNAMIC_BUFFER=y",
        "CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y",
        "CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y",
        "# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set",
        "# CONFIG_MBEDTLS_HARDWARE_AES is not set",
        "# CONFIG_MBEDTLS_AES_USE_INTERRUPT is not set",
        "# CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER is not set",
        "CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096",
        "CONFIG_XIAOZHI_SKIP_OTA_VERSION_CHECK=y",
        "CONFIG_MIMI_SECRET_MODEL_PROVIDER=\"openai\"",
        "CONFIG_MIMI_SECRET_MODEL=\"deepseek-chat\"",
        "CONFIG_MIMI_SECRET_OPENAI_API_URL=\"https://api.deepseek.com/chat/completions\"",
        "CONFIG_OPENCLAW_BAIDU_TTS_API_KEY=\"\"",
        "CONFIG_OPENCLAW_BAIDU_TTS_SECRET_KEY=\"\"",
        "CONFIG_OPENCLAW_BAIDU_TTS_CUID=\"openclaw-esp32s3\"",
        "CONFIG_LV_USE_IMGFONT=y",
        "CONFIG_LV_FONT_FMT_TXT_LARGE=y",
        "CONFIG_COMPILER_CXX_EXCEPTIONS=y",
        "CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024",
        "CONFIG_COMPILER_CXX_RTTI=y"
    ]
}
    ]
}
